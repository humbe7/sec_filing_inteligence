# SEC Filing Intelligence - Environment Variables

# ===== SEC API Configuration =====
# SEC User-Agent string (required by SEC for fair access)
SEC_CONTACT_EMAIL=your-email@example.com

# Maximum requests per second to SEC API (default: 8, max allowed: 10)
SEC_MAX_REQUESTS_PER_SECOND=8

# ===== Apify Configuration =====
# Apify token (optional for local development, required for cloud deployment)
# APIFY_TOKEN=your-apify-token

# ===== AI/LLM Configuration (optional Phase 4 analysis) =====
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=30000

# Native Anthropic Claude support (takes precedence when configured)
# ANTHROPIC_API_KEY=your-anthropic-key
# ANTHROPIC_WORKSPACE_ID=your-workspace-id # Required for identity-linked keys
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_TIMEOUT_MS=30000

# ===== Logging =====
# Log level: DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# ===== Pay-Per-Event Billing (optional Phase 7) =====
# Enable only after configuring basic-analysis, filing-comparison, and
# full-intelligence events in Apify Console.
ENABLE_PPE_CHARGING=false

# ===== Cost Controls =====
# Maximum number of AI calls per run (1-4)
MAX_AI_CALLS=4

# Cap each filing section included in an AI prompt (1,000-12,000 characters)
MAX_INPUT_CHARS=12000

# Cap deterministic changed sentences included in each AI prompt (1-10)
MAX_CHANGED_CHUNKS=5

# Maximum output tokens for AI
MAX_OUTPUT_TOKENS=1200

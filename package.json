{
  "name": "sec-filing-intelligence",
  "version": "0.1.0",
  "description": "SEC Filing Intelligence Actor for Apify - Automated analysis of SEC filings",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sec",
    "edgar",
    "filing",
    "apify",
    "actor",
    "financial-analysis",
    "10-k",
    "10-q",
    "8-k"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "apify": "^3.6.0",
    "axios": "^1.6.0",
    "zod": "^3.22.0"
  },
  "overrides": {
    "@crawlee/core": {
      "minimatch": "9.0.7"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^8.54.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.0.0",
    "eslint": "^8.54.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
